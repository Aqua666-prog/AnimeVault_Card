# Получите токен у @BotFather. Значения ниже — только шаблоны.
BOT_TOKEN=replace_with_botfather_token
POSTGRES_DB=cardlegends
POSTGRES_USER=cardlegends_owner
POSTGRES_PASSWORD=replace_with_random_owner_password
APP_DB_PASSWORD=replace_with_random_app_password
# Пароль в URL должен быть percent-encoded, если содержит спецсимволы.
DATABASE_URL=postgresql+asyncpg://cardlegends_app:replace_with_random_app_password@db:5432/cardlegends
MIGRATION_DATABASE_URL=postgresql+asyncpg://cardlegends_owner:replace_with_random_owner_password@db:5432/cardlegends
LOG_LEVEL=INFO
